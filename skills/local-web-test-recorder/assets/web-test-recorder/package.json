{
  "name": "local-web-test-recorder",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:unit": "node --test tests/*.unit.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.58.2"
  }
}
