# Copy to .env.local for local development. Set the same names in the Vercel project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server only. Never prefix with NEXT_PUBLIC and never commit the value.
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5
ANTHROPIC_MODEL=
