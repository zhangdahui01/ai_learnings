  "auth_flows": {
    "guest": "tap Enter: a random ID is drawn; the token lives in app storage until the visitor leaves",
    "registered": "'my own ID' form: a new ID is registered and a return code is shown once; on the same device the ID alone walks back in; on another device the ID plus the return code"
  },
  "preconditions": {
    "hall_server": "node projects/quiet-hall/server/server.mjs",
    "walking": "walking is a tap on the 3D floor: it has no element id, so UI cases cannot target it; the server tests cover the rule",
    "forced_trial": "web only: open the page with ?trial=dog or ?trial=fairies to make a trial start about 2.5 s after sitting; ?trial=off disables trials (the default for the other cases)"
  },
  "environments": {
    "local": {
      "api": "http://127.0.0.1:8787",
      "web": "http://127.0.0.1:8790",
      "android_emulator_api": "http://10.0.2.2:8787"
    },
    "app": {
      "android_package": "dev.clientx.quiethall",
      "android_activity": ".MainActivity",
      "ios_bundle_id": "dev.clientx.quiethall"
    },
    "visit_log": {
      "local": "data/events.jsonl next to the hall data file",
      "deployed": "Supabase table quiet_hall_events; views quiet_hall_daily and quiet_hall_visitors; readable by the project owner only"
    }
  }
}
